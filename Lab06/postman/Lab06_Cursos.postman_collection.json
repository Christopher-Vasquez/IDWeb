




{
  "info": {
    "name": "Lab06 - API RESTful de Cursos",
    "description": "Colección de pruebas del Lab 06. Ejecutar las carpetas en orden (Runner), con el servidor activo en http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "cursoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Consultas (GET)",
      "item": [
        {
          "name": "Listar todos los cursos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status es success', () => pm.expect(pm.response.json().status).to.eql('success'));",
                  "pm.test('data es un arreglo', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            }
          }
        },
        {
          "name": "Filtrar por créditos (query string)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Todos los cursos tienen 4 créditos', () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.length).to.be.above(0);",
                  "    data.forEach(c => pm.expect(c.creditos).to.eql(4));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos?creditos=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ],
              "query": [
                {
                  "key": "creditos",
                  "value": "4"
                }
              ]
            }
          }
        },
        {
          "name": "Obtener curso por id (existe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el curso con id 1', () => pm.expect(pm.response.json().data.id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "1"
              ]
            }
          }
        },
        {
          "name": "Obtener curso por id (no existe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('status es fail', () => pm.expect(pm.response.json().status).to.eql('fail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Escritura (POST, PUT, DELETE)",
      "item": [
        {
          "name": "Crear curso (válido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201 Created', () => pm.response.to.have.status(201));",
                  "const curso = pm.response.json().data;",
                  "pm.test('Devuelve el curso creado con id', () => {",
                  "    pm.expect(curso.id).to.be.a('number');",
                  "    pm.expect(curso.codigo).to.eql('RED-401');",
                  "});",
                  "pm.collectionVariables.set('cursoId', curso.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Desarrollo de Software Orientado a Objetos I\",\n  \"codigo\": \"DSOO-401\",\n  \"creditos\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear curso (campos faltantes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Indica campos obligatorios', () => pm.expect(pm.response.json().message).to.include('obligatorios'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sin código ni créditos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Actualizar curso (existe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Los datos fueron actualizados', () => {",
                  "    const curso = pm.response.json().data;",
                  "    pm.expect(curso.nombre).to.eql('Desarrollo de Software Orientado a Objetos II');",
                  "    pm.expect(curso.creditos).to.eql(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/{{cursoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Desarrollo de Software Orientado a Objetos II\",\n  \"codigo\": \"DSOO-402\",\n  \"creditos\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Actualizar curso (no existe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "999"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"X\",\n  \"codigo\": \"X-1\",\n  \"creditos\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar curso (existe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Mensaje de confirmación', () => pm.expect(pm.response.json().message).to.include('eliminado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/{{cursoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}"
              ]
            }
          }
        },
        {
          "name": "Eliminar curso (ya eliminado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/{{cursoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}"
              ]
            }
          }
        }
      ]
    },
