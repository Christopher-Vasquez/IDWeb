{
  "info": {
    "name": "Lab07 - Autenticación y Sesiones (Artesanías y Artes Manuales)",
    "description": "Flujo Registro - Login - Ruta privada - Logout. Ejecutar la colección completa con el Runner, en orden y con el servidor activo en http://localhost:3000. Las cookies de sesión las gestiona Postman automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "password",
      "value": "Clave12345"
    },
    {
      "key": "emailArtesano",
      "value": ""
    },
    {
      "key": "emailCliente",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Registro (POST /api/auth/register)",
      "item": [
        {
          "name": "Registrar artesano (válido)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Emails únicos en cada ejecución para poder repetir la colección sin reiniciar el servidor",
                  "const marca = Date.now();",
                  "pm.collectionVariables.set('emailArtesano', `artesano${marca}@taller.com`);",
                  "pm.collectionVariables.set('emailCliente', `cliente${marca}@correo.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Rol artesano asignado', () => pm.expect(pm.response.json().data.rol).to.eql('artesano'));",
                  "pm.test('La respuesta NO expone el hash ni la contraseña', () => {\n    const txt = pm.response.text();\n    pm.expect(txt).to.not.include('passwordHash');\n    pm.expect(txt).to.not.include('$2b$');\n    pm.expect(txt).to.not.include('Clave12345');\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailArtesano}}\",\n  \"password\": \"{{password}}\",\n  \"rol\": \"artesano\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registrar con email repetido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 409 Conflict', () => pm.response.to.have.status(409));"
                ]
